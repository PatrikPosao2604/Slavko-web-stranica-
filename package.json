{
  "name": "diesel-servis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:dist": "npx --yes http-server dist/diesel-servis/browser -p 4300 -c-1",
    "images": "node scripts/generate-placeholder-images.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:preview": "ng build --configuration preview"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/node": "^20.17.19",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  }
}
